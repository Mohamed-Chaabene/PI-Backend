# Local Development Configuration Template
# Copy this file to .env and update with your local settings

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/jobmatch_db
DB_USERNAME=root
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8080

# Application Profile
SPRING_PROFILE=dev

# JWT Configuration (if applicable)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Logging Level
LOG_LEVEL=INFO
